#!/bin/bash

# Keep office on the laptop and project management/web on an external display.
# Reapply only when the selected outputs change, allowing manual rearrangement.
last_layout=""

place_workspaces() {
  local layout office_output output
  layout=$(niri msg -j outputs | jq -r '
    [.[] | select(.current_mode != null)] as $outputs |
    ([$outputs[] | select(.name | startswith("eDP-"))][0]) as $laptop |
    [$outputs[] | select(.name != $laptop.name)] as $external |
    ([$external[] | select(.make == "Samsung Electric Company" and
       .model == "CF791" and .serial == "HTRJ401453")][0] //
     [$external[] | select(.make == "Lenovo Group Limited" and
       .model == "L29w-30" and .serial == "UPV0RWN9")][0] //
     $external[0] // $laptop) as $work |
    if $work == null then empty
    else [($laptop // $work).name, $work.name] | @tsv end
  ') || return 1

  [[ -z $layout || $layout == "$last_layout" ]] && return 0
  IFS=$'\t' read -r office_output output <<< "$layout"

  niri msg action move-workspace-to-monitor --reference office "$office_output" || return 1
  niri msg action move-workspace-to-monitor --reference projmgmt "$output" || return 1
  niri msg action move-workspace-to-monitor --reference web "$output" || return 1
  # Prepend in reverse order: office | projmgmt, web on two screens;
  # projmgmt, office, web when all three share one screen.
  niri msg action move-workspace-to-index --reference web 1 || return 1
  niri msg action move-workspace-to-index --reference office 1 || return 1
  niri msg action move-workspace-to-index --reference projmgmt 1 || return 1
  last_layout="$layout"
}

if [[ ${1:-} == "--watch" ]]; then
  # Avoid duplicate watchers when applying the configuration to a live session.
  exec 9>"$XDG_RUNTIME_DIR/lowr-niri-workspaces.lock"
  flock -n 9 || exit 0

  # The stream starts with the current workspace state and updates on hotplug.
  while IFS= read -r event; do
    if jq -e 'has("WorkspacesChanged")' <<< "$event" >/dev/null; then
      place_workspaces
    fi
  done < <(niri msg -j event-stream)
else
  place_workspaces
fi
