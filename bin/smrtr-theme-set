#!/bin/bash

if [[ -z $1 ]]; then
  echo "Usage: smrtr-theme-set <theme-name>"
  exit 1
fi

CURRENT_THEME_PATH="$HOME/.config/smrtr/current/theme"
NEXT_THEME_PATH="$HOME/.config/smrtr/current/next-theme"
USER_THEMES_PATH="$HOME/.config/smrtr/themes"
SMRTR_THEMES_PATH="$SMRTR_PATH/themes"

THEME_NAME=$(echo "$1" | sed -E 's/<[^>]+>//g' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')

if [[ ! -d $SMRTR_THEMES_PATH/$THEME_NAME ]] && [[ ! -d $USER_THEMES_PATH/$THEME_NAME ]]; then
  echo "Theme '$THEME_NAME' does not exist"
  exit 1
fi

# Setup clean next theme directory (for atomic theme config swapping)
rm -rf "$NEXT_THEME_PATH"
mkdir -p "$NEXT_THEME_PATH"

# Copy official theme first, then overlay user customizations on top
cp -r "$SMRTR_THEMES_PATH/$THEME_NAME/"* "$NEXT_THEME_PATH/" 2>/dev/null
cp -r "$USER_THEMES_PATH/$THEME_NAME/"* "$NEXT_THEME_PATH/" 2>/dev/null

# Generate dynamic configs
smrtr-theme-set-templates

# Swap next theme in as current
rm -rf "$CURRENT_THEME_PATH"
mv "$NEXT_THEME_PATH" "$CURRENT_THEME_PATH"

# Store theme name for reference
echo "$THEME_NAME" >"$HOME/.config/smrtr/current/theme.name"

# Change background with theme
smrtr-theme-bg-next

# Restart components to apply new theme
if pgrep -x waybar >/dev/null; then
  smrtr-restart-waybar
fi
smrtr-restart-swayosd
smrtr-restart-terminal
smrtr-restart-hyprctl
smrtr-restart-btop
smrtr-restart-opencode
smrtr-restart-mako

# Change app-specific themes
smrtr-theme-set-gnome
smrtr-theme-set-browser
smrtr-theme-set-vscode
smrtr-theme-set-obsidian
smrtr-theme-set-keyboard

# Call hook on theme set
smrtr-hook theme-set "$THEME_NAME"
