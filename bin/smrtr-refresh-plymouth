#!/bin/bash

# Overwrite the user config for the Plymouth drive decryption and boot sequence with the Smrtr default and rebuild it.

sudo cp ~/.local/share/smrtr/default/plymouth/* /usr/share/plymouth/themes/smrtr/
sudo plymouth-set-default-theme smrtr

if command -v limine-mkinitcpio &>/dev/null; then
  sudo limine-mkinitcpio
else
  sudo mkinitcpio -P
fi
