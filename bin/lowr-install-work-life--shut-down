#!/bin/bash

# Install and enable the Lowr work-life shutdown timer.

set -e

LOWR_PATH=${LOWR_PATH:-"$HOME/.local/share/lowr"}
SYSTEMD_USER_DIR="$HOME/.config/systemd/user"

echo "Installing work-life shutdown dependencies..."
if lowr-cmd-missing sqlite3; then
  lowr-pkg-add sqlite
fi

if lowr-cmd-missing notify-send; then
  lowr-pkg-add libnotify
fi

echo "Installing work-life shutdown systemd user units..."
mkdir -p "$SYSTEMD_USER_DIR"
cp "$LOWR_PATH/config/systemd/user/lowr-work-life--shut-down.service" "$SYSTEMD_USER_DIR/"
cp "$LOWR_PATH/config/systemd/user/lowr-work-life--shut-down.timer" "$SYSTEMD_USER_DIR/"

systemctl --user daemon-reload
systemctl --user enable --now lowr-work-life--shut-down.timer

echo
echo "Work-life shutdown timer installed and running."
echo
echo "Configure it in: $HOME/.config/lowr/work-life--shut-down.env"
echo
echo "Example:"
echo "  SHUTDOWN_WINDOWS=22:00-04:30"
echo "  WARNING_MINUTES=5"
