#!/usr/bin/env bash
set -euo pipefail

if (($# == 0)); then
    printf 'Usage: smrtr-launch-or-focus-tui <command> [args...]\n' >&2
    exit 1
fi

APP_ID="org.smrtr.$(basename "$1")"

focus_existing_window() {
    command -v niri >/dev/null || return 1
    command -v jq >/dev/null || return 1

    local windows_json window_id

    windows_json="$(niri msg -j windows 2>/dev/null || true)"
    [[ -n "$windows_json" ]] || return 1

    window_id="$(jq -r --arg app "$APP_ID" '
        map(
            select(
                (.app_id // .["app-id"] // .window_properties.app_id // "") == $app
                or ((.title // "") | test($app; "i"))
            )
        )
        | first
        | .id // .window_id // .["window-id"] // empty
    ' <<<"$windows_json")"

    [[ -n "$window_id" ]] || return 1

    niri msg action focus-window --id "$window_id" >/dev/null 2>&1 || \
        niri msg action focus-window "$window_id" >/dev/null 2>&1 || true
    return 0
}

if focus_existing_window; then
    exit 0
fi

exec setsid ghostty --class "$APP_ID" -e "$1" "${@:2}"
