#!/bin/bash

# Launch or focus on a given TUI identified by the passed in as the command.
# Use by commands like lowr-launch-wifi to ensure there is only one wifi configuration screen open.

APP_ID="org.lowr.$(basename "$1")"
LAUNCH_COMMAND="lowr-launch-tui $@"

exec lowr-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
