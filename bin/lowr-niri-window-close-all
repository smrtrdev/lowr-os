#!/bin/bash

windows=$(niri msg -j windows 2>/dev/null | jq -r '.[].id' 2>/dev/null)

if [[ -z $windows ]]; then
  exit 0
fi

while IFS= read -r id; do
  [[ -n $id ]] || continue
  niri msg action focus-window --id "$id" >/dev/null 2>&1 || true
  niri msg action close-window >/dev/null 2>&1 || true
done <<<"$windows"
