#!/bin/bash

# Install ActivityWatch for time tracking: window, idle, git repo, and browser activity.

set -e

LOWR_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# ── Step 1: Install AUR packages ─────────────────────────────────────────────

echo "Installing ActivityWatch..."
if ! lowr-pkg-present activitywatch-bin; then
  lowr-pkg-aur-add activitywatch-bin
fi

# Use Lowr's Wayland-native afk watcher and niri watcher for idle and window tracking.
echo "Installing ActivityWatch helpers..."
if lowr-cmd-missing jq curl; then
  lowr-pkg-add jq curl
fi
if lowr-cmd-missing sqlite3; then
  lowr-pkg-add sqlite
fi
if lowr-cmd-missing swayidle; then
  lowr-pkg-add swayidle
fi

# ── Step 2: Install systemd user service files ───────────────────────────────

# activitywatch-bin doesn't install service files to systemd paths.
echo "Installing ActivityWatch service files..."
mkdir -p "$HOME/.config/systemd/user"
mkdir -p "$HOME/.config/autostart"

cat > "$HOME/.config/systemd/user/aw-server.service" << 'EOF'
[Unit]
Description=ActivityWatch Server
After=network.target

[Service]
Type=notify
ExecStart=/opt/activitywatch/aw-server-rust/aw-server-rust
Restart=on-failure

[Install]
WantedBy=default.target
EOF

cat > "$HOME/.config/systemd/user/lowr-aw-afk-watcher.service" << 'EOF'
[Unit]
Description=Lowr ActivityWatch Wayland AFK Watcher
After=aw-server.service
Requires=aw-server.service

[Service]
Environment=PATH=%h/.local/share/lowr/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/share/lowr/bin/lowr-aw-afk-watcher
Restart=on-failure

[Install]
WantedBy=default.target
EOF

cat > "$HOME/.config/systemd/user/lowr-aw-window-watcher.service" << 'EOF'
[Unit]
Description=Lowr ActivityWatch niri Window Watcher
After=aw-server.service
Requires=aw-server.service

[Service]
Environment=PATH=%h/.local/share/lowr/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/share/lowr/bin/lowr-aw-window-watcher
Restart=on-failure

[Install]
WantedBy=default.target
EOF

# Prevent aw-qt autostart from launching the stock aw-watcher-window watcher.
cat > "$HOME/.config/autostart/aw-qt.desktop" << 'EOF'
[Desktop Entry]
Type=Application
Name=ActivityWatch
Hidden=true
EOF

systemctl --user daemon-reload

# ── Step 3: Enable systemd user services ─────────────────────────────────────

echo "Enabling ActivityWatch services..."
systemctl --user import-environment WAYLAND_DISPLAY DISPLAY NIRI_SOCKET XDG_RUNTIME_DIR
systemctl --user enable --now aw-server.service
systemctl --user disable --now aw-awatcher.service >/dev/null 2>&1 || true
rm -f "$HOME/.config/systemd/user/aw-awatcher.service"
systemctl --user disable --now aw-watcher-afk.service >/dev/null 2>&1 || true
rm -f "$HOME/.config/systemd/user/aw-watcher-afk.service"
systemctl --user enable --now lowr-aw-afk-watcher.service
systemctl --user restart lowr-aw-afk-watcher.service
systemctl --user enable --now lowr-aw-window-watcher.service
systemctl --user restart lowr-aw-window-watcher.service

# ── Step 4: Install Git commit integration ────────────────────────────────────

echo "Installing ActivityWatch Git hook..."
hook_source="$LOWR_PATH/config/git/hooks/post-commit"
global_hooks=$(git config --global --path --get core.hooksPath 2>/dev/null || true)
system_hooks=$(git config --system --path --get core.hooksPath 2>/dev/null || true)
local_hooks=$(git config --local --path --get core.hooksPath 2>/dev/null || true)
repository_git_dir=$(git rev-parse --git-common-dir 2>/dev/null || true)
repository_hook=""
if [[ -n $repository_git_dir ]]; then
  repository_hook="$repository_git_dir/hooks/post-commit"
fi
managed_hooks="$HOME/.config/git/hooks"
hook_target=""

if [[ -n $global_hooks && $global_hooks == /* ]]; then
  hook_target="$global_hooks/post-commit"
elif [[ -n $global_hooks ]]; then
  echo "  Existing global core.hooksPath is repository-relative: $global_hooks"
  echo "  Lowr did not modify it. Add the dispatcher to each resolved hook directory if desired."
elif [[ -n $system_hooks ]]; then
  echo "  Existing system core.hooksPath is configured: $system_hooks"
  echo "  Lowr did not override it. Add a dispatcher for lowr-aw-git-heartbeat there if desired."
elif [[ -n $repository_hook && -e $repository_hook ]]; then
  echo "  Existing repository post-commit hook preserved: $repository_hook"
  echo "  Lowr did not configure a global hooks path because that would bypass this hook."
elif [[ -t 0 ]]; then
  echo "  A global core.hooksPath applies to all repositories and bypasses hooks in their default .git/hooks directories."
  read -r -p "  Configure the Lowr-managed global hooks path? [y/N] " configure_hooks
  if [[ $configure_hooks == "y" || $configure_hooks == "Y" ]]; then
    mkdir -p "$managed_hooks"
    git config --global core.hooksPath "$managed_hooks"
    hook_target="$managed_hooks/post-commit"
  else
    echo "  Git commit heartbeat hook skipped. Local Git history will still be queried."
  fi
else
  echo "  Git hook setup needs confirmation before configuring a global core.hooksPath; skipped in this noninteractive run."
fi

if [[ -n $hook_target ]]; then
  mkdir -p "$(dirname "$hook_target")"
  if [[ -e $hook_target ]] && ! cmp -s "$hook_source" "$hook_target"; then
    echo "  Existing post-commit hook preserved: $hook_target"
    echo "  Add this line to it to enable commit evidence:"
    echo "    \"$HOME/.local/share/lowr/bin/lowr-aw-git-heartbeat\" >/dev/null 2>&1 || true"
  else
    install -m 755 "$hook_source" "$hook_target"
    echo "  Git commit evidence enabled through $hook_target"
  fi
fi

if [[ -n $local_hooks ]]; then
  echo "  This repository overrides core.hooksPath with $local_hooks; its hook was not changed."
fi

echo "  Restart GUI Git clients if they were open during installation."

# ── Step 5: Browser extension instructions ───────────────────────────────────

echo
echo "──────────────────────────────────────────────────────────"
echo "  Browser Extension (for web activity tracking)"
echo "──────────────────────────────────────────────────────────"
echo "  Search 'ActivityWatch Web Watcher' in:"
echo "    - Chrome Web Store  (for Chromium)"
echo "    - Firefox Add-ons   (for Firefox / Zen Browser)"
echo "  It connects automatically to http://localhost:5600"
echo "──────────────────────────────────────────────────────────"

# ── Step 6: Success summary ───────────────────────────────────────────────────

echo
echo "ActivityWatch installed and running!"
echo
echo "  Tracking:"
echo "    Window / app activity  (lowr-aw-window-watcher)"
echo "    Idle / AFK time        (lowr-aw-afk-watcher)"
echo "    Directory + git repo   (shell hook — bash + nushell)"
echo "    Git commits            (post-commit hook when safely installed)"
echo "    Browser                (install extension above)"
echo
echo "  Dashboard: http://localhost:5600"
echo "  Deterministic record: lowr-aw-time-tracker-record"
echo "  AI-assisted record:  lowr-aw-time-tracker-ai-record"
echo "  Tracker data:        ~/.config/time-tracker/"
echo
echo "  Shell tracking is active in new terminal sessions."
