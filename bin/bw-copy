#!/usr/bin/env nu

# Search Bitwarden vault and copy the first result's password to clipboard.

use ./bw-get

def show-help [] {
    print -e "Usage: bw-copy.nu [--collection (-c) <name|guid>] [--search (-s) <term|guid>]"
    print -e ""
    print -e "Searches Bitwarden via bw-get and copies the first result's password to clipboard."
    print -e ""
    print -e "Options:"
    print -e "  -c, --collection  Collection name or GUID to filter by"
    print -e "  -s, --search      Search term or item GUID"
    print -e "  -h, --help        Show this help message"
    print -e "  -n, --skip-login  Skip login (assume BW_SESSION is already set)"
    print -e ""
    print -e "Examples:"
    print -e "  bw-copy.nu -s github           # Copy password for first 'github' match"
    print -e "  bw-copy.nu -c Servers -s db    # Copy password for 'db' in 'Servers'"
}

export def --env main [
    --collection (-c): string  # Collection name or GUID to filter by
    --search (-s): string      # Search term or item GUID
    --help (-h)                # Show help message
    --skip-login (-n)          # Skip login (assume BW_SESSION is already set)
] {
    if $help {
        show-help
        return
    }

    # Compute defaults into variables to avoid parsing ambiguities in argument positions
    let col = ($collection | default "")
    let term = ($search | default "")

    # Call bw-get on a single line (avoid placing flags on their own lines which can confuse the parser)
    let results = (if $skip_login {
        (bw-get --collection $col --search $term --skip-login)
    } else {
        (bw-get --collection $col --search $term)
    })

    if ($results | is-empty) {
        print -e "No results to copy."
        return
    }

    let first = ($results | first)
    let pw = ($first | get password)

    if ($pw | is-empty) {
        print -e $"No password for '($first.name)'."
        return
    }

    $pw | wl-copy
    print -e $"Copied password for '($first.name)' to clipboard."
}
