#!/bin/bash

# Creates a new Smrtr migration named after the unix timestamp of the last commit.
# Only intended for Smrtr developers.

cd ~/.local/share/smrtr
migration_file="$HOME/.local/share/smrtr/migrations/$(git log -1 --format=%cd --date=unix).sh"
touch $migration_file

if [[ $1 != "--no-edit" ]]; then
  nvim $migration_file
fi

echo $migration_file
