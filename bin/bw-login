#!/usr/bin/env nu

# Ensure Bitwarden CLI is logged in, unlocked, and BW_SESSION is set.
# Uses --env so BW_SESSION propagates to the caller's scope.

export def --env main [] {
    print -e "Checking Bitwarden status..."
    mut status = (bw status | from json)

    # Step 1: Log in if unauthenticated
    if $status.status == "unauthenticated" {
        print -e "Not logged in."

        # Choose server
        let server = (["https://vault.bitwarden.eu" "https://vault.bitwarden.com" "Custom URL"] | input list "Select Bitwarden server:")
        let server_url = if $server == "Custom URL" {
            print -e -n "Enter server URL: "
            input
        } else {
            $server
        }
        bw config server $server_url

        # Choose login method
        let method = (["sso" "masterpassword" "api_key"] | input list "Select login method:")
        if $method == "sso" {
            print -e -n "Organization identifier: "
            let org = (input)
            bw login --sso $org
        } else if $method == "masterpassword" {
            print -e -n "Email: "
            let email = (input)
            print -e -n "Master password: "
            let pass = (input -s)
            print -e ""
            bw login $email $pass
        } else if $method == "api_key" {
            print -e -n "Client ID: "
            let client_id = (input)
            print -e -n "Client secret: "
            let client_secret = (input -s)
            print -e ""
            $env.BW_CLIENTID = $client_id
            $env.BW_CLIENTSECRET = $client_secret
            bw login --apikey
        }

        $status = (bw status | from json)
        if $status.status == "unauthenticated" {
            print -e "Login failed."
            exit 1
        }
        print -e "Login successful."
    }

    # Step 2: Unlock if locked and return session key
    if $status.status == "locked" {
        print -e -n "Master password: "
        let password = (input -s)
        print -e ""
        print -e "Unlocking vault..."
        let session = (bw unlock $password --raw)
        if ($session | is-empty) {
            print -e "Unlock failed."
            exit 1
        }
        print -e "Vault unlocked."
        $env.BW_SESSION = $session
        $session
    } else if $status.status == "unlocked" {
        print -e "Vault already unlocked."
    }
}
