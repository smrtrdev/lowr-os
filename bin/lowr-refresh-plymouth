#!/bin/bash

# Overwrite the user config for the Plymouth drive decryption and boot sequence with the Lowr default and rebuild it.

sudo cp ~/.local/share/lowr/default/plymouth/* /usr/share/plymouth/themes/lowr/
sudo plymouth-set-default-theme lowr

if command -v limine-mkinitcpio &>/dev/null; then
  sudo limine-mkinitcpio
else
  sudo mkinitcpio -P
fi
