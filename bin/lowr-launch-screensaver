#!/bin/bash

# Launch the Lowr screensaver in the default terminal on the system with the correct font configuration.

# Exit early if we don't have the tte show
if ! command -v tte &>/dev/null; then
  exit 1
fi

# Exit early if screensave is already running
pgrep -f org.lowr.screensaver && exit 0

# Allow screensaver to be turned off but also force started
if [[ -f ~/.local/state/lowr/toggles/screensaver-off ]] && [[ $1 != "force" ]]; then
  exit 1
fi

# Silently quit Walker on overlay
walker -q

terminal=$(xdg-terminal-exec --print-id)

case $terminal in
*Alacritty*)
  setsid uwsm-app -- \
    alacritty --class=org.lowr.screensaver \
    --config-file ~/.local/share/lowr/default/alacritty/screensaver.toml \
    -e lowr-cmd-screensaver >/dev/null 2>&1 &
  ;;
*ghostty*)
  setsid uwsm-app -- \
    ghostty --class=org.lowr.screensaver \
    --config-file=~/.local/share/lowr/default/ghostty/screensaver \
    --font-size=18 \
    -e lowr-cmd-screensaver >/dev/null 2>&1 &
  ;;
*kitty*)
  setsid uwsm-app -- \
    kitty --class=org.lowr.screensaver \
    --override font_size=18 \
    --override window_padding_width=0 \
    -e lowr-cmd-screensaver >/dev/null 2>&1 &
  ;;
*)
  notify-send "✋  Screensaver only runs in Alacritty, Ghostty, or Kitty"
  ;;
esac
