#!/usr/bin/env nu

# Get passwords and usernames from Bitwarden vault.

# use ./bw-login

def is-guid [s: string] {
    ($s | parse -r '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$' | length) > 0
}

# Extract login fields from a list of Bitwarden items.
def login-fields [items: list] {
    $items | where type == 1 | each {|row|
        {
            username: ($row.login?.username? | default "")
            password: ($row.login?.password? | default "")
            name: $row.name
            id: $row.id
        }
    }
}

# Resolve a collection name or GUID to a collection ID.
# Returns the ID string, or null if resolution fails (with messages printed).
def resolve-collection [collection: string] {
    if (is-guid $collection) {
        return $collection
    }
    print -e $"Searching collections for '($collection)'..."
    let cols = (bw list collections --search $collection | from json | select id name)
    if ($cols | is-empty) {
        print -e "No collections found."
        return null
    }
    if ($cols | length) > 1 {
        print -e "Multiple collections found:"
        print -e ($cols | rename collectionid name | table)
        return null
    }
    print -e "Collection:"
    print -e ($cols | rename collectionid name | table)
    $cols | first | get id
}

def show-help [] {
    print -e "Usage: bw-get.nu [--collection (-c) <name|guid>] [--search (-s) <term|guid>]"
    print -e ""
    print -e "Options:"
    print -e "  -c, --collection  Collection name or GUID to filter by"
    print -e "  -s, --search      Search term or item GUID"
    print -e "  -h, --help        Show this help message"
    print -e "  -n, --skip-login  Skip login (assume BW_SESSION is already set)"
    print -e ""
    print -e "Examples:"
    print -e "  bw-get.nu -s github           # Search all items for 'github'"
    print -e "  bw-get.nu -s <guid>           # Get item by GUID"
    print -e "  bw-get.nu -c Servers          # List logins in collection 'Servers'"
    print -e "  bw-get.nu -c Servers -s db    # Search 'db' within collection 'Servers'"
}

export def --env main [
    --collection (-c): string  # Collection name or GUID to filter by
    --search (-s): string      # Search term or item GUID
    --help (-h)                # Show help message
    --skip-login (-n)          # Skip login (assume BW_SESSION is already set)
] {
    if $help {
        show-help
        return
    }

    if ($collection | is-empty) and ($search | is-empty) {
        show-help
        return
    }

    # Ensure logged in and set session
    if not $skip_login {
        bw-login
    }

    if ($collection | is-empty) {
        # --search only
        if (is-guid $search) {
            print -e $"Fetching item ($search)..."
            let item = (bw get item $search | from json)
            login-fields [$item]
        } else {
            print -e $"Searching items for '($search)'..."
            let items = (bw list items --search $search | from json)
            if ($items | is-empty) {
                print -e "No items found."
                return
            }
            login-fields $items
        }
    } else {
        # --collection (with or without --search)
        let col_id = (resolve-collection $collection)
        if ($col_id == null) { return }

        if ($search | is-empty) {
            print -e "Listing items in collection..."
            let items = (bw list items --collectionid $col_id | from json)
            let logins = (login-fields $items)
            if ($logins | is-empty) {
                print -e "No logins in this collection."
                return
            }
            $logins
        } else {
            print -e $"Searching collection for '($search)'..."
            let items = (bw list items --collectionid $col_id --search $search | from json)
            if ($items | is-empty) {
                print -e "No items found."
                return
            }
            login-fields $items
        }
    }
}
