#!/bin/bash
set -e

# Overwrite all user configs with the Smrtr defaults.

if (( EUID == 0 )); then
  echo "Error: This script should not be run as root"
  exit 1
fi

echo "Resetting all Smrtr configs"
cp -R ~/.local/share/smrtr/config/* ~/.config/
cp ~/.local/share/smrtr/default/bashrc ~/.bashrc
echo '[[ -f ~/.bashrc ]] && . ~/.bashrc' | tee ~/.bash_profile >/dev/null

$(bash $SMRTR_PATH/install/config/theme.sh)

smrtr-refresh-limine
smrtr-refresh-plymouth
smrtr-nvim-setup
